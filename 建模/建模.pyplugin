<?xml version="1.0" encoding="UTF-8"?>
<BIMPyPlugin>
    <BfaLibName>建模</BfaLibName>
    <PluginVersion>1.0.6</PluginVersion>
    <LoadStatus>true</LoadStatus>
    <Category name="建模插件库">
        <Panel name="建模工具">
            <Button name="曲线建模">
                <command>quxian.py</command>
                <iconPath>settings.ico</iconPath>
            </Button>
            <Button name="圆柱建模">
                <command>yuanzhu.py</command>
                <iconPath>pile.ico</iconPath>
            </Button>
            <Button name="自动配置环境">
                <command>环境配置.py</command>
                <iconPath>settings.ico</iconPath>
            </Button>
        </Panel>
    </Category>
    <Name>建模</Name>
    <!-- 这里指定插件所在的文件夹路径 -->
    <PluginModule>C:\ProgramData\PKPM\BIMBase\Plugins\Pro\V1.6\pythonplugin\建模</PluginModule>
    <PluginSDKVersion>1.6.2</PluginSDKVersion>
</BIMPyPlugin>
